---
import { getCollection } from 'astro:content';
import ListingCard from './ListingCard.astro';

interface Props {
  collection: 'restaurants' | 'bars' | 'attractions';
  currentId: string;
  area: string;
  category: string;
  title?: string;
  limit?: number;
}

const {
  collection,
  currentId,
  area,
  category,
  title = 'More to explore',
  limit = 3,
} = Astro.props;

const all = await getCollection(collection);
const others = all.filter(entry => entry.id !== currentId);
const sameArea = others.filter(entry => entry.data.area === area);
const sameCategory = others.filter(entry => entry.data.category === category && entry.data.area !== area);
const remaining = others.filter(entry => !sameArea.includes(entry) && !sameCategory.includes(entry));
const related = [...sameArea, ...sameCategory, ...remaining].slice(0, limit);
---
{related.length > 0 && (
  <section class="related-places editorial-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Keep going</p>
        <h2>{title}</h2>
      </div>
      <a href={`/${collection}`} class="text-link">View all →</a>
    </div>
    <ul class="listing-grid related-grid">
      {related.map((entry, index) => (
        <ListingCard
          href={`/${collection}/${entry.id}`}
          name={entry.data.name}
          category={entry.data.category}
          area={entry.data.area}
          rating={entry.data.rating}
          tags={entry.data.tags}
          priceRange={entry.data.priceRange}
          entryFee={entry.data.entryFee}
          image={entry.data.image}
          index={index + 1}
        />
      ))}
    </ul>
  </section>
)}
