---
interface Field {
  label: string;
  value: string;
}

interface Props {
  description: string;
  fields: Field[];
}

const { description, fields } = Astro.props;
---
<aside class="info-card">
  <p class="eyebrow">At a glance</p>
  <p class="info-card-summary">{description}</p>
  <dl class="info-card-fields">
    {fields.map(field => (
      <div class="info-field">
        <dt>{field.label}</dt>
        <dd>{field.value}</dd>
      </div>
    ))}
  </dl>
</aside>
