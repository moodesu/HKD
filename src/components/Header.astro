---
import SearchBox from './SearchBox.astro';

const pathname = Astro.url.pathname;
const navItems = [
  { label: 'Eat', href: '/restaurants' },
  { label: 'Drink', href: '/bars' },
  { label: 'See', href: '/attractions' },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---
<header class="site-header">
  <div class="site-header-row">
    <a href="/" class="masthead" aria-label="Hakodate home">
      <span class="masthead-name">HAKODATE</span>
      <span class="masthead-deck">Local food · drink · places</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {navItems.map(item => (
        <a href={item.href} class={isActive(item.href) ? 'active' : undefined} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-search">
      <SearchBox instanceId="header" />
    </div>

    <button id="nav-toggle" class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer">
      <span></span><span></span>
    </button>
  </div>
</header>

<div id="nav-backdrop" class="nav-backdrop"></div>
<aside id="nav-drawer" class="nav-drawer" aria-hidden="true">
  <div class="drawer-head">
    <span class="drawer-title">HAKODATE</span>
    <button id="nav-drawer-close" class="nav-drawer-close" aria-label="Close menu">Close</button>
  </div>
  <nav class="nav-drawer-links" aria-label="Mobile navigation">
    <a href="/">Home</a>
    {navItems.map(item => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="nav-drawer-search">
    <SearchBox instanceId="drawer" />
  </div>
  <p class="drawer-note">An independent local guide to Hakodate, Hokkaido.</p>
</aside>

<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('nav-drawer');
  const backdrop = document.getElementById('nav-backdrop');
  const closeBtn = document.getElementById('nav-drawer-close');

  function openDrawer() {
    drawer.classList.add('open');
    backdrop.classList.add('open');
    toggle.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.classList.add('menu-open');
  }

  function closeDrawer() {
    drawer.classList.remove('open');
    backdrop.classList.remove('open');
    toggle.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('menu-open');
  }

  toggle?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDrawer();
  });
</script>
