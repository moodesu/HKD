---
interface Props {
  href: string;
  name: string;
  category: string;
  area: string;
  rating: number;
  tags: string[];
  priceRange?: string;
  entryFee?: string;
  filterable?: boolean;
}

const { href, name, category, area, rating, tags, priceRange, entryFee, filterable = false } = Astro.props;
---
<li
  class="listing-card"
  data-category={filterable ? category : undefined}
  data-area={filterable ? area : undefined}
  data-tags={filterable ? tags.join(',') : undefined}
>
  <a href={href}>
    <h2>{name}</h2>
    <p>{category} — {area}</p>
    <p>
      {priceRange && <>{priceRange} · </>}
      {entryFee && <>{entryFee} · </>}
      ★ {rating}
    </p>
    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </a>
</li>