---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  href: string;
  name: string;
  category: string;
  area: string;
  rating: number;
  tags: string[];
  priceRange?: string;
  entryFee?: string;
  image?: ImageMetadata;
  filterable?: boolean;
}

const { href, name, category, area, rating, tags, priceRange, entryFee, image, filterable = false } = Astro.props;
---
<li
  class="listing-card"
  data-category={filterable ? category : undefined}
  data-area={filterable ? area : undefined}
  data-tags={filterable ? tags.join(',') : undefined}
>
  <a href={href}>
    <div class="card-image">
      {image ? (
        <Image src={image} alt={name} width={400} height={300} />
      ) : (
        <div class="card-image-placeholder"></div>
      )}
    </div>
    <div class="card-body">
      <h2>{name}</h2>
      <p>{category} — {area}</p>
      <p>
        {priceRange && <>{priceRange} · </>}
        {entryFee && <>{entryFee} · </>}
        ★ {rating}
      </p>
      <div class="tags">
        {tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </a>
</li>