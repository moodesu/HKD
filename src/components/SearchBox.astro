---
interface Props {
  instanceId?: string;
}
const { instanceId = 'default' } = Astro.props;
---
<div class="search-box">
  <input
    type="search"
    id={`search-input-${instanceId}`}
    placeholder="Search the guide"
    aria-label="Search the Hakodate guide"
    autocomplete="off"
  />
</div>

<script define:vars={{ instanceId }} is:inline>
  const input = document.getElementById(`search-input-${instanceId}`);

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const term = input.value.trim();
      if (term) {
        window.location.href = `/search?q=${encodeURIComponent(term)}`;
      }
    }
  });
</script>
