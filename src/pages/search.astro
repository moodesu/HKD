---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const restaurants = await getCollection('restaurants');
const bars = await getCollection('bars');
const attractions = await getCollection('attractions');

const placeLookup = Object.fromEntries([
  ...restaurants.map(entry => [
    `/restaurants/${entry.id}`,
    {
      title: entry.data.name,
      type: 'Eat',
      category: entry.data.category,
      area: entry.data.area,
      detail: entry.data.priceRange,
      image: entry.data.image?.src ?? null,
    },
  ]),
  ...bars.map(entry => [
    `/bars/${entry.id}`,
    {
      title: entry.data.name,
      type: 'Drink',
      category: entry.data.category,
      area: entry.data.area,
      detail: entry.data.priceRange,
      image: entry.data.image?.src ?? null,
    },
  ]),
  ...attractions.map(entry => [
    `/attractions/${entry.id}`,
    {
      title: entry.data.name,
      type: 'See',
      category: entry.data.category,
      area: entry.data.area,
      detail: entry.data.entryFee,
      image: entry.data.image?.src ?? null,
    },
  ]),
]);
---
<BaseLayout title="Search" description="Search Hakodate Guide">
  <div class="detail-page">
    <h1 id="search-query-display">Search Results</h1>
    <ul id="full-search-results" class="listing-grid"></ul>
    <p id="no-results" class="filter-empty" style="display:none;">No results found.</p>
  </div>
</BaseLayout>

<script define:vars={{ placeLookup }} is:inline>
  function normalizePath(url) {
    const pathname = new URL(url, window.location.origin).pathname;
    return pathname.length > 1 ? pathname.replace(/\/$/, '') : pathname;
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  async function runFullSearch() {
    const params = new URLSearchParams(window.location.search);
    const term = params.get('q') || '';

    document.getElementById('search-query-display').textContent = term
      ? `Results for "${term}"`
      : 'Search';

    if (!term) return;

    const pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
    await pagefind.init();

    const search = await pagefind.search(term);
    const resultsList = document.getElementById('full-search-results');
    const noResults = document.getElementById('no-results');

    const matches = search.results
      .map(result => ({ result, meta: placeLookup[normalizePath(result.url)] }))
      .filter(item => item.meta);

    if (matches.length === 0) {
      noResults.style.display = 'block';
      return;
    }

    for (const { result, meta } of matches) {
      const li = document.createElement('li');
      li.className = 'listing-card';

      const imageBlock = meta.image
        ? `<div class="card-image"><img src="${escapeHtml(meta.image)}" alt="${escapeHtml(meta.title)}" loading="lazy" /></div>`
        : `<div class="card-image"><div class="card-image-placeholder"><span class="placeholder-label">Image to come</span></div></div>`;

      li.innerHTML = `
        <a href="${escapeHtml(result.url)}">
          ${imageBlock}
          <div class="card-body">
            <div class="card-meta-row">
              <span>${escapeHtml(meta.type)}</span>
              <span>${escapeHtml(meta.area)}</span>
            </div>
            <h2>${escapeHtml(meta.title)}</h2>
            <p class="card-details">
              <span>${escapeHtml(meta.category)}</span>
              ${meta.detail ? `<span>${escapeHtml(meta.detail)}</span>` : ''}
            </p>
          </div>
        </a>
      `;

      resultsList.appendChild(li);
    }
  }

  runFullSearch();
</script>
