---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search" description="Search Hakodate Guide">
  <div class="detail-page">
    <h1 id="search-query-display">Search Results</h1>
    <ul id="full-search-results" class="listing-grid"></ul>
    <p id="no-results" style="display:none;">No results found.</p>
  </div>
</BaseLayout>

<script is:inline>
  async function runFullSearch() {
    const params = new URLSearchParams(window.location.search);
    const term = params.get('q') || '';

    document.getElementById('search-query-display').textContent = term
      ? `Results for "${term}"`
      : 'Search';

    if (!term) return;

    const pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
    await pagefind.init();

    const search = await pagefind.search(term);
    const resultsList = document.getElementById('full-search-results');
    const noResults = document.getElementById('no-results');

    if (search.results.length === 0) {
      noResults.style.display = 'block';
      return;
    }

    for (const result of search.results) {
      const data = await result.data();
      const li = document.createElement('li');
      li.className = 'listing-card';

      const imageBlock = data.meta.image
        ? `<div class="card-image"><img src="${data.meta.image}" alt="${data.meta.title}" loading="lazy" /></div>`
        : `<div class="card-image"><div class="card-image-placeholder"></div></div>`;

      const tagList = data.filters.tag || [];
      const tagsBlock = tagList.length > 0
        ? `<div class="tags">${tagList.map(t => `<span class="tag">${t}</span>`).join('')}</div>`
        : '';

      li.innerHTML = `
        <a href="${data.url}">
          ${imageBlock}
          <div class="card-body">
            <h2>${data.meta.title}</h2>
            <p>${data.excerpt}</p>
            ${tagsBlock}
          </div>
        </a>
      `;
      resultsList.appendChild(li);
    }
  }

  runFullSearch();
</script>