---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const restaurants = await getCollection('restaurants');
const bars = await getCollection('bars');
const attractions = await getCollection('attractions');

const makeSearchText = (entry, extras = []) => [
  entry.data.name,
  entry.data.category,
  entry.data.area,
  entry.data.address,
  ...(entry.data.tags ?? []),
  ...extras,
  entry.body ?? '',
]
  .filter(Boolean)
  .join(' ');

const placeLookup = Object.fromEntries([
  ...restaurants.map(entry => [
    `/restaurants/${entry.id}`,
    {
      title: entry.data.name,
      type: 'Eat',
      category: entry.data.category,
      area: entry.data.area,
      detail: entry.data.priceRange,
      image: entry.data.image?.src ?? null,
      searchText: makeSearchText(entry, [
        entry.data.priceRange,
        entry.data.hours,
      ]),
    },
  ]),
  ...bars.map(entry => [
    `/bars/${entry.id}`,
    {
      title: entry.data.name,
      type: 'Drink',
      category: entry.data.category,
      area: entry.data.area,
      detail: entry.data.priceRange,
      image: entry.data.image?.src ?? null,
      searchText: makeSearchText(entry, [
        entry.data.priceRange,
        entry.data.happyHour,
      ]),
    },
  ]),
  ...attractions.map(entry => [
    `/attractions/${entry.id}`,
    {
      title: entry.data.name,
      type: 'See',
      category: entry.data.category,
      area: entry.data.area,
      detail: entry.data.entryFee,
      image: entry.data.image?.src ?? null,
      searchText: makeSearchText(entry, [
        entry.data.openingHours,
        entry.data.entryFee,
      ]),
    },
  ]),
]);
---
<BaseLayout title="Search" description="Search Hakodate Guide">
  <main class="search-page">
    <header class="search-page-header">
      <p class="eyebrow">Find a place</p>
      <h1 id="search-query-display" class="search-page-title">Search the guide</h1>

      <form class="search-page-form" action="/search" method="get" role="search">
        <label class="sr-only" for="search-page-input">Search the Hakodate guide</label>
        <input
          id="search-page-input"
          name="q"
          type="search"
          placeholder="Restaurant, bar, attraction, area…"
          autocomplete="off"
        />
        <button type="submit">Search</button>
      </form>

      <p id="search-page-intro" class="search-page-intro">
        Search by place name, category, neighbourhood, tag or something mentioned in a local note.
      </p>
    </header>

    <section class="search-results" aria-live="polite">
      <ul id="full-search-results" class="listing-grid search-results-grid"></ul>
      <p id="no-results" class="search-empty" style="display:none;">No results found.</p>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ placeLookup }} is:inline>
  function normalizePath(url) {
    const pathname = new URL(url, window.location.origin).pathname;
    return pathname.length > 1 ? pathname.replace(/\/$/, '') : pathname;
  }

  function normalizeText(value) {
    return String(value ?? '')
      .normalize('NFKD')
      .toLowerCase()
      .replace(/[^\p{L}\p{N}]+/gu, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function sourceActuallyMatches(searchText, term) {
    const haystack = normalizeText(searchText);
    const tokens = normalizeText(term).split(' ').filter(Boolean);

    return tokens.every(token => {
      if (haystack.includes(token)) return true;

      if (token.length > 3 && token.endsWith('s') && haystack.includes(token.slice(0, -1))) {
        return true;
      }

      if (token.length > 3 && haystack.includes(`${token}s`)) {
        return true;
      }

      return false;
    });
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  async function runFullSearch() {
    const params = new URLSearchParams(window.location.search);
    const term = params.get('q')?.trim() || '';
    const title = document.getElementById('search-query-display');
    const input = document.getElementById('search-page-input');
    const intro = document.getElementById('search-page-intro');

    if (input) input.value = term;

    title.textContent = term ? `Results for "${term}"` : 'Search the guide';

    if (!term) {
      intro.style.display = 'block';
      return;
    }

    intro.style.display = 'none';

    const pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
    await pagefind.init();

    const search = await pagefind.search(term);
    const resultsList = document.getElementById('full-search-results');
    const noResults = document.getElementById('no-results');

    const matches = (await Promise.all(
      search.results.map(async result => {
        const data = await result.data();
        const meta = placeLookup[normalizePath(data.url)];

        if (!meta || !sourceActuallyMatches(meta.searchText, term)) {
          return null;
        }

        return { data, meta };
      })
    )).filter(Boolean);

    if (matches.length === 0) {
      noResults.style.display = 'block';
      return;
    }

    for (const { data, meta } of matches) {
      const li = document.createElement('li');
      li.className = 'listing-card';

      const imageBlock = meta.image
        ? `<div class="card-image"><img src="${escapeHtml(meta.image)}" alt="${escapeHtml(meta.title)}" loading="lazy" /></div>`
        : `<div class="card-image"><div class="card-image-placeholder"><span class="placeholder-label">Image to come</span></div></div>`;

      li.innerHTML = `
        <a href="${escapeHtml(data.url)}">
          ${imageBlock}
          <div class="card-body">
            <div class="card-meta-row">
              <span>${escapeHtml(meta.type)}</span>
              <span>${escapeHtml(meta.area)}</span>
            </div>
            <h2>${escapeHtml(meta.title)}</h2>
            <p class="card-details">
              <span>${escapeHtml(meta.category)}</span>
              ${meta.detail ? `<span>${escapeHtml(meta.detail)}</span>` : ''}
            </p>
          </div>
        </a>
      `;

      resultsList.appendChild(li);
    }
  }

  runFullSearch();
</script>
