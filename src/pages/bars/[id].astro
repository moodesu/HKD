---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoCard from '../../components/InfoCard.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import RelatedPlaces from '../../components/RelatedPlaces.astro';
import BackToTop from '../../components/BackToTop.astro';

export async function getStaticPaths() {
  const bars = await getCollection('bars');
  return bars.map(bar => ({
    params: { id: bar.id },
    props: { bar },
  }));
}

const { bar } = Astro.props;
const { Content } = await render(bar);

const fields = [
  { label: 'Category', value: bar.data.category },
  { label: 'Area', value: bar.data.area },
  { label: 'Price', value: bar.data.priceRange },
  ...(bar.data.happyHour ? [{ label: 'Happy Hour', value: bar.data.happyHour }] : []),
  { label: 'Address', value: bar.data.address },
  { label: 'Rating', value: `${bar.data.rating} / 5` },
];
---
<BaseLayout title={bar.data.name} description={bar.data.name} image={bar.data.image}>
  <article data-pagefind-body class="detail-page">

    <header class="detail-header">
      <div class="tags">
        {bar.data.tags.map(tag => <a href={`/tags/${tag}`} class="tag">{tag}</a>)}
      </div>
      <h1>{bar.data.name}</h1>
    </header>

    {bar.data.image && (
      <Image src={bar.data.image} alt={bar.data.name} width={800} height={500} class="detail-hero" />
    )}

    {/* TODO: replace auto-generated description below with a manually written summary per entry */}
    <div data-pagefind-ignore>
  <InfoCard description={`A ${bar.data.category} spot in ${bar.data.area}.`} fields={fields} />
</div>

    <div class="review-card">
      <h2>The Review</h2>
      <div class="review-body">
        <Content />
      </div>
    </div>

    <MapEmbed address={bar.data.address} name={bar.data.name} />

    <RelatedPlaces
      collection="bars"
      currentId={bar.id}
      area={bar.data.area}
      category={bar.data.category}
    />

    <RelatedPlaces
      collection="restaurants"
      currentId={bar.id}
      area={bar.data.area}
      category={bar.data.category}
    />

    <BackToTop />
  </article>
</BaseLayout>