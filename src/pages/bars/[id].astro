---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoCard from '../../components/InfoCard.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import RelatedPlaces from '../../components/RelatedPlaces.astro';
import BackToTop from '../../components/BackToTop.astro';

export async function getStaticPaths() {
  const bars = await getCollection('bars');
  return bars.map(bar => ({ params: { id: bar.id }, props: { bar } }));
}

const { bar } = Astro.props;
const { Content } = await render(bar);
const fields = [
  { label: 'Category', value: bar.data.category },
  { label: 'Area', value: bar.data.area },
  { label: 'Price', value: bar.data.priceRange },
  ...(bar.data.happyHour ? [{ label: 'Happy Hour', value: bar.data.happyHour }] : []),
  { label: 'Address', value: bar.data.address },
  ...(bar.data.rating > 0 ? [{ label: 'Rating', value: `${bar.data.rating} / 5` }] : []),
];
---
<BaseLayout title={bar.data.name} description={`${bar.data.name} — ${bar.data.category} in ${bar.data.area}`} image={bar.data.image}>
  <article class="detail-page">
    <div data-pagefind-body>
      <header class="detail-header">
        <p class="eyebrow">Drink · {bar.data.area}</p>
        <h1>{bar.data.name}</h1>
        <p class="detail-deck">{bar.data.category} in {bar.data.area}.</p>
        <div class="tags">{bar.data.tags.map(tag => <a href={`/tags/${tag}`} class="tag">{tag}</a>)}</div>
      </header>

      {bar.data.image && (
        <Image src={bar.data.image} alt={bar.data.name} width={1400} height={900} class="detail-hero" />
      )}

      <div class="detail-columns">
        <div class="detail-sidebar"><InfoCard description={`${bar.data.category} in ${bar.data.area}.`} fields={fields} /></div>
        <section class="detail-story"><p class="eyebrow">The local note</p><div class="review-body"><Content /></div></section>
      </div>
    </div>

    <section class="location-section">
      <div class="section-heading"><div><p class="eyebrow">Find it</p><h2>{bar.data.area}</h2></div><p class="location-address">{bar.data.address}</p></div>
      <MapEmbed address={bar.data.address} name={bar.data.name} />
    </section>

    <RelatedPlaces collection="restaurants" currentId={bar.id} area={bar.data.area} category={bar.data.category} title="Nearby places to eat" />
    <BackToTop />
  </article>
</BaseLayout>
