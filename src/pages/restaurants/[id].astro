---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const restaurants = await getCollection('restaurants');
  return restaurants.map(restaurant => ({
    params: { id: restaurant.id },
    props: { restaurant },
  }));
}

const { restaurant } = Astro.props;
const { Content } = await render(restaurant);
---
<BaseLayout title={restaurant.data.name} description={restaurant.data.name} image={restaurant.data.image}>
  <article data-pagefind-body>
    <h1>{restaurant.data.name}</h1>

    {restaurant.data.image && (
      <Image
        src={restaurant.data.image}
        alt={restaurant.data.name}
        width={800}
        height={500}
        class="detail-hero"
      />
    )}

    <p><strong>{restaurant.data.category}</strong> — {restaurant.data.area}</p>

    <ul>
      <li>Price: {restaurant.data.priceRange}</li>
      <li>Hours: {restaurant.data.hours}</li>
      <li>Address: {restaurant.data.address}</li>
      <li>Rating: {restaurant.data.rating} / 5</li>
    </ul>

    <div class="tags">
      {restaurant.data.tags.map(tag => <span class="tag">{tag}</span>)}
    </div>

    <div class="review-body">
      <Content />
    </div>
  </article>
</BaseLayout>