---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoCard from '../../components/InfoCard.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import RelatedPlaces from '../../components/RelatedPlaces.astro';
import BackToTop from '../../components/BackToTop.astro';

export async function getStaticPaths() {
  const restaurants = await getCollection('restaurants');
  return restaurants.map(restaurant => ({ params: { id: restaurant.id }, props: { restaurant } }));
}

const { restaurant } = Astro.props;
const { Content } = await render(restaurant);
const fields = [
  { label: 'Category', value: restaurant.data.category },
  { label: 'Area', value: restaurant.data.area },
  { label: 'Price', value: restaurant.data.priceRange },
  { label: 'Hours', value: restaurant.data.hours },
  { label: 'Address', value: restaurant.data.address },
  ...(restaurant.data.rating > 0 ? [{ label: 'Rating', value: `${restaurant.data.rating} / 5` }] : []),
];
---
<BaseLayout title={restaurant.data.name} description={`${restaurant.data.name} — ${restaurant.data.category} in ${restaurant.data.area}`} image={restaurant.data.image}>
  <article class="detail-page">
    <div data-pagefind-body>
      <header class="detail-header">
        <p class="eyebrow">Eat · {restaurant.data.area}</p>
        <h1>{restaurant.data.name}</h1>
        <p class="detail-deck">{restaurant.data.category} in {restaurant.data.area}.</p>
        <div class="tags">{restaurant.data.tags.map(tag => <a href={`/tags/${tag}`} class="tag">{tag}</a>)}</div>
      </header>

      {restaurant.data.image && (
        <Image src={restaurant.data.image} alt={restaurant.data.name} width={1400} height={900} class="detail-hero" />
      )}

      <div class="detail-columns">
        <div class="detail-sidebar">
          <InfoCard description={`${restaurant.data.category} in ${restaurant.data.area}.`} fields={fields} />
        </div>
        <section class="detail-story">
          <p class="eyebrow">The local note</p>
          <div class="review-body"><Content /></div>
        </section>
      </div>
    </div>

    <section class="location-section">
      <div class="section-heading">
        <div><p class="eyebrow">Find it</p><h2>{restaurant.data.area}</h2></div>
        <p class="location-address">{restaurant.data.address}</p>
      </div>
      <MapEmbed address={restaurant.data.address} name={restaurant.data.name} />
    </section>

    <RelatedPlaces collection="restaurants" currentId={restaurant.id} area={restaurant.data.area} category={restaurant.data.category} title="More places to eat" />
    <BackToTop />
  </article>
</BaseLayout>
