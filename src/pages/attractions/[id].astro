---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoCard from '../../components/InfoCard.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import RelatedPlaces from '../../components/RelatedPlaces.astro';
import BackToTop from '../../components/BackToTop.astro';


export async function getStaticPaths() {
  const attractions = await getCollection('attractions');
  return attractions.map(attraction => ({
    params: { id: attraction.id },
    props: { attraction },
  }));
}

const { attraction } = Astro.props;
const { Content } = await render(attraction);

const fields = [
  { label: 'Category', value: attraction.data.category },
  { label: 'Area', value: attraction.data.area },
  { label: 'Opening Hours', value: attraction.data.openingHours },
  { label: 'Entry Fee', value: attraction.data.entryFee },
  { label: 'Address', value: attraction.data.address },
  { label: 'Rating', value: `${attraction.data.rating} / 5` },
];
---
<BaseLayout title={attraction.data.name} description={attraction.data.name} image={attraction.data.image}>
  <article data-pagefind-body class="detail-page">

    <header class="detail-header">
      <div class="tags">
        {attraction.data.tags.map(tag => <a href={`/tags/${tag}`} class="tag">{tag}</a>)}
      </div>
      <h1>{attraction.data.name}</h1>
    </header>

    {attraction.data.image && (
      <Image src={attraction.data.image} alt={attraction.data.name} width={800} height={500} class="detail-hero" />
    )}

    {/* TODO: replace auto-generated description below with a manually written summary per entry */}
    <div data-pagefind-ignore>
      <InfoCard description={`A ${attraction.data.category} in ${attraction.data.area}.`} fields={fields} />
    </div>

    <div class="review-card">
      <h2>The Review</h2>
      <div class="review-body">
        <Content />
      </div>
    </div>

    <MapEmbed address={attraction.data.address} name={attraction.data.name} />

    <RelatedPlaces
      collection="attractions"
      currentId={attraction.id}
      area={attraction.data.area}
      category={attraction.data.category}
    />
    <RelatedPlaces
      collection="attractions"
      currentId={attraction.id}
      area={attraction.data.area}
      category={attraction.data.category}
    />

    <BackToTop />
  </article>
</BaseLayout>