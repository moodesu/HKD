---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoCard from '../../components/InfoCard.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import RelatedPlaces from '../../components/RelatedPlaces.astro';
import BackToTop from '../../components/BackToTop.astro';

export async function getStaticPaths() {
  const attractions = await getCollection('attractions');
  return attractions.map(attraction => ({ params: { id: attraction.id }, props: { attraction } }));
}

const { attraction } = Astro.props;
const { Content } = await render(attraction);
const fields = [
  { label: 'Category', value: attraction.data.category },
  { label: 'Area', value: attraction.data.area },
  { label: 'Opening Hours', value: attraction.data.openingHours },
  { label: 'Entry Fee', value: attraction.data.entryFee },
  { label: 'Address', value: attraction.data.address },
  ...(attraction.data.rating > 0 ? [{ label: 'Rating', value: `${attraction.data.rating} / 5` }] : []),
];
---
<BaseLayout title={attraction.data.name} description={`${attraction.data.name} — ${attraction.data.category} in ${attraction.data.area}`} image={attraction.data.image}>
  <article data-pagefind-body class="detail-page">
    <header class="detail-header">
      <p class="eyebrow">See · {attraction.data.area}</p>
      <h1>{attraction.data.name}</h1>
      <p class="detail-deck">{attraction.data.category} in {attraction.data.area}.</p>
      <div class="tags">{attraction.data.tags.map(tag => <a href={`/tags/${tag}`} class="tag">{tag}</a>)}</div>
    </header>

    {attraction.data.image && <Image src={attraction.data.image} alt={attraction.data.name} width={1400} height={900} class="detail-hero" />}

    <div class="detail-columns">
      <div data-pagefind-ignore class="detail-sidebar"><InfoCard description={`${attraction.data.category} in ${attraction.data.area}.`} fields={fields} /></div>
      <section class="detail-story"><p class="eyebrow">The local note</p><div class="review-body"><Content /></div></section>
    </div>

    <section class="location-section" data-pagefind-ignore>
      <div class="section-heading"><div><p class="eyebrow">Find it</p><h2>{attraction.data.area}</h2></div><p class="location-address">{attraction.data.address}</p></div>
      <MapEmbed address={attraction.data.address} name={attraction.data.name} />
    </section>

    <RelatedPlaces collection="attractions" currentId={attraction.id} area={attraction.data.area} category={attraction.data.category} title="More places to see" />
    <BackToTop />
  </article>
</BaseLayout>
