---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingCard from '../../components/ListingCard.astro';
import Hero from '../../components/Hero.astro';
import attractionsHero from '../../assets/hero/attractions.jpg';

const allAttractions = (await getCollection('attractions')).sort((a, b) => b.data.rating - a.data.rating);
const categories = [...new Set(allAttractions.map(entry => entry.data.category))].sort();
const areas = [...new Set(allAttractions.map(entry => entry.data.area))].sort();
const allTags = [...new Set(allAttractions.flatMap(entry => entry.data.tags))].sort();
---
<BaseLayout title="Attractions" description="Places to see and things to do in and around Hakodate">
  <Hero title="See" subtitle="Harbour views, historic streets, parks, and places that explain the city." image={attractionsHero} eyebrow="Hakodate guide · Places" count={allAttractions.length} sectionNumber="03" />

  <section class="directory-section">
    <div class="directory-toolbar">
      <div><p class="eyebrow">The directory</p><p id="result-count" class="result-count">{allAttractions.length} {allAttractions.length === 1 ? 'place' : 'places'}</p></div>
      <details class="filter-panel">
        <summary>Filter <span>+</span></summary>
        <div class="filters">
          <label>Category<select id="filter-category"><option value="">All categories</option>{categories.map(value => <option value={value}>{value}</option>)}</select></label>
          <label>Area<select id="filter-area"><option value="">All areas</option>{areas.map(value => <option value={value}>{value}</option>)}</select></label>
          <label>Tag<select id="filter-tag"><option value="">All tags</option>{allTags.map(value => <option value={value}>{value}</option>)}</select></label>
          <button id="filter-reset" class="filter-reset" type="button">Reset filters</button>
        </div>
      </details>
    </div>

    <ul class="listing-grid directory-grid">
      {allAttractions.map((entry, index) => (
        <ListingCard href={`/attractions/${entry.id}`} name={entry.data.name} category={entry.data.category} area={entry.data.area} rating={entry.data.rating} tags={entry.data.tags} entryFee={entry.data.entryFee} image={entry.data.image} filterable={true} variant={index === 0 ? 'feature' : 'standard'} index={index + 1} />
      ))}
    </ul>
    <p id="filter-empty" class="filter-empty" hidden>No places match those filters.</p>
  </section>
</BaseLayout>

<script>
  const categorySelect = document.getElementById('filter-category') as HTMLSelectElement;
  const areaSelect = document.getElementById('filter-area') as HTMLSelectElement;
  const tagSelect = document.getElementById('filter-tag') as HTMLSelectElement;
  const reset = document.getElementById('filter-reset') as HTMLButtonElement;
  const count = document.getElementById('result-count') as HTMLElement;
  const empty = document.getElementById('filter-empty') as HTMLElement;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-filter-card]')];
  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const matches = (!categorySelect.value || card.dataset.category === categorySelect.value) && (!areaSelect.value || card.dataset.area === areaSelect.value) && (!tagSelect.value || card.dataset.tags?.split(',').includes(tagSelect.value));
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    count.textContent = `${visible} ${visible === 1 ? 'place' : 'places'}`;
    empty.hidden = visible !== 0;
  }
  [categorySelect, areaSelect, tagSelect].forEach(select => select.addEventListener('change', applyFilters));
  reset.addEventListener('click', () => { categorySelect.value = ''; areaSelect.value = ''; tagSelect.value = ''; applyFilters(); });
</script>
