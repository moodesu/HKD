---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingCard from '../../components/ListingCard.astro';
import Hero from '../../components/Hero.astro';
import attractionsHero from '../../assets/hero/attractions.jpg';

const allAttractions = await getCollection('attractions');
const categories = [...new Set(allAttractions.map(a => a.data.category))].sort();
const areas = [...new Set(allAttractions.map(a => a.data.area))].sort();
const allTags = [...new Set(allAttractions.flatMap(a => a.data.tags))].sort();
---
<BaseLayout title="Attractions" description="Attractions in and around Hakodate">
  <Hero title="Attractions" subtitle="Places to see around Hakodate" image={attractionsHero} />

  <div class="filters">
    <label>
      Category
      <select id="filter-category">
        <option value="">All</option>
        {categories.map(c => <option value={c}>{c}</option>)}
      </select>
    </label>
    <label>
      Area
      <select id="filter-area">
        <option value="">All</option>
        {areas.map(a => <option value={a}>{a}</option>)}
      </select>
    </label>
    <label>
      Tag
      <select id="filter-tag">
        <option value="">All</option>
        {allTags.map(t => <option value={t}>{t}</option>)}
      </select>
    </label>
  </div>

  <ul id="attraction-list" class="featured-grid">
    {allAttractions.map((a, i) => (
      <ListingCard
        href={`/attractions/${a.id}`}
        name={a.data.name}
        category={a.data.category}
        area={a.data.area}
        rating={a.data.rating}
        tags={a.data.tags}
        entryFee={a.data.entryFee}
        image={a.data.image}
        filterable={true}
        featured={i === 0}
      />
    ))}
  </ul>
</BaseLayout>

<script>
  const categorySelect = document.getElementById('filter-category') as HTMLSelectElement;
  const areaSelect = document.getElementById('filter-area') as HTMLSelectElement;
  const tagSelect = document.getElementById('filter-tag') as HTMLSelectElement;
  const cards = document.querySelectorAll<HTMLElement>('.listing-card');

  function applyFilters() {
    const category = categorySelect.value;
    const area = areaSelect.value;
    const tag = tagSelect.value;

    cards.forEach(card => {
      const matchesCategory = !category || card.dataset.category === category;
      const matchesArea = !area || card.dataset.area === area;
      const matchesTag = !tag || card.dataset.tags?.split(',').includes(tag);
      card.style.display = (matchesCategory && matchesArea && matchesTag) ? '' : 'none';
    });
  }

  categorySelect.addEventListener('change', applyFilters);
  areaSelect.addEventListener('change', applyFilters);
  tagSelect.addEventListener('change', applyFilters);
</script>