---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCard from '../components/ListingCard.astro';
import HeroCarousel from '../components/HeroCarousel.astro';

const restaurants = await getCollection('restaurants');
const bars = await getCollection('bars');
const attractions = await getCollection('attractions');

const topRestaurants = [...restaurants].sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);
const topBars = [...bars].sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);
const topAttractions = [...attractions].sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);

const carouselSlides = [
  ...topRestaurants.map(r => ({ name: r.data.name, category: 'Restaurant', href: `/restaurants/${r.id}`, image: r.data.image })),
  ...topBars.map(b => ({ name: b.data.name, category: 'Bar', href: `/bars/${b.id}`, image: b.data.image })),
  ...topAttractions.map(a => ({ name: a.data.name, category: 'Attraction', href: `/attractions/${a.id}`, image: a.data.image })),
].filter(slide => slide.image);

const allEntries = [
  ...restaurants.map(r => ({
    href: `/restaurants/${r.id}`,
    typeLabel: 'Restaurant',
    name: r.data.name,
    category: r.data.category,
    area: r.data.area,
    rating: r.data.rating,
    tags: r.data.tags,
    priceRange: r.data.priceRange as string | undefined,
    entryFee: undefined as string | undefined,
    image: r.data.image,
  })),
  ...bars.map(b => ({
    href: `/bars/${b.id}`,
    typeLabel: 'Bar',
    name: b.data.name,
    category: b.data.category,
    area: b.data.area,
    rating: b.data.rating,
    tags: b.data.tags,
    priceRange: b.data.priceRange as string | undefined,
    entryFee: undefined as string | undefined,
    image: b.data.image,
  })),
  ...attractions.map(a => ({
    href: `/attractions/${a.id}`,
    typeLabel: 'Attraction',
    name: a.data.name,
    category: a.data.category,
    area: a.data.area,
    rating: a.data.rating,
    tags: a.data.tags,
    priceRange: undefined as string | undefined,
    entryFee: a.data.entryFee as string | undefined,
    image: a.data.image,
  })),
].sort((a, b) => b.rating - a.rating);
---
<BaseLayout title="Home" description="A local guide to Hakodate — restaurants, bars, and attractions">
  <HeroCarousel slides={carouselSlides} />

  <div class="section-header">
    <h2>All places</h2>
  </div>

  <ul class="listing-grid">
  {allEntries.map(entry => (
    <ListingCard
      href={entry.href}
      name={entry.name}
      category={entry.category}
      area={entry.area}
      rating={entry.rating}
      tags={entry.tags}
      priceRange={entry.priceRange}
      entryFee={entry.entryFee}
      image={entry.image}
      typeLabel={entry.typeLabel}
    />
  ))}
</ul>
</BaseLayout>