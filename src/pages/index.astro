---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ListingCard from '../components/ListingCard.astro';

const restaurants = await getCollection('restaurants');
const bars = await getCollection('bars');
const attractions = await getCollection('attractions');

const topRestaurants = [...restaurants].sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);
const topBars = [...bars].sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);
const topAttractions = [...attractions].sort((a, b) => b.data.rating - a.data.rating).slice(0, 3);
---
<BaseLayout title="Home" description="A local guide to Hakodate — restaurants, bars, and attractions">
  <section class="hero">
    <h1>Hakodate Guide</h1>
    <p>Restaurants, bars, and attractions in and around Hakodate, Hokkaido — picked and reviewed locally.</p>
  </section>

  {topRestaurants.length > 0 && (
    <section class="featured">
      <div class="section-header">
        <h2>Top Restaurants</h2>
        <a href="/restaurants">See all →</a>
      </div>
      <ul class="listing-grid">
        {topRestaurants.map(r => (
          <ListingCard
            href={`/restaurants/${r.id}`}
            name={r.data.name}
            category={r.data.category}
            area={r.data.area}
            rating={r.data.rating}
            tags={r.data.tags}
            priceRange={r.data.priceRange}
            image={r.data.image}
          />
        ))}
      </ul>
    </section>
  )}

  {topBars.length > 0 && (
    <section class="featured">
      <div class="section-header">
        <h2>Top Bars</h2>
        <a href="/bars">See all →</a>
      </div>
      <ul class="listing-grid">
        {topBars.map(b => (
          <ListingCard
            href={`/bars/${b.id}`}
            name={b.data.name}
            category={b.data.category}
            area={b.data.area}
            rating={b.data.rating}
            tags={b.data.tags}
            priceRange={b.data.priceRange}
            image={b.data.image}
          />
        ))}
      </ul>
    </section>
  )}

  {topAttractions.length > 0 && (
    <section class="featured">
      <div class="section-header">
        <h2>Top Attractions</h2>
        <a href="/attractions">See all →</a>
      </div>
      <ul class="listing-grid">
        {topAttractions.map(a => (
          <ListingCard
            href={`/attractions/${a.id}`}
            name={a.data.name}
            category={a.data.category}
            area={a.data.area}
            rating={a.data.rating}
            tags={a.data.tags}
            entryFee={a.data.entryFee}
            image={a.data.image}
          />
        ))}
      </ul>
    </section>
  )}
</BaseLayout>